{
  "name": "global-work-status",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 9440 --strictPort",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "oxlint src",
    "check-types": "tsc --noEmit",
    "quality": "bun run lint && bun run check-types && bun run test && bun run test:native && bun run build",
    "test": "bun test hooks tests",
    "test:native": "cargo test --locked --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "oxlint": "1.76.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20"
  }
}
