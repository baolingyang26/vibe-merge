{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Vibe Merge",
  "version": "0.0.1",
  "identifier": "com.repo.globalworkstatus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:9440",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vibe Merge",
        "width": 72,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "fullscreen": false,
        "minWidth": 72,
        "visible": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
