{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Global Work Status",
  "version": "0.0.1",
  "identifier": "com.repo.globalworkstatus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:9440",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Global Work Status",
        "width": 78,
        "height": 780,
        "resizable": false,
        "decorations": false,
        "fullscreen": false,
        "minWidth": 78,
        "visible": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
